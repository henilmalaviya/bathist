<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>bathist • Battery Analytics & Telemetry</title>
  <!-- Google Fonts & Chart.js -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg-canvas: #000000;
      --bg-card: #0a0a0a;
      --bg-card-hover: #121212;
      --border-main: #222222;
      --border-hover: #333333;
      --text-primary: #ededed;
      --text-secondary: #888888;
      --text-muted: #555555;
      --accent-blue: #0070f3;
      --accent-cyan: #06b6d4;
      --accent-green: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --accent-purple: #8b5cf6;
      --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Geist Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-sans);
      letter-spacing: -0.02em;
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    /* Header */
    .app-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border-main);
      gap: 16px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .app-logo-badge {
      width: 42px;
      height: 42px;
      background: var(--bg-card);
      border: 1px solid var(--border-main);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .brand-title h1 {
      font-size: 22px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.03em;
    }

    .brand-title p {
      font-size: 13px;
      color: var(--text-secondary);
    }

    /* Actions Toolbar */
    .toolbar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: #ffffff;
      color: #000000;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-primary:hover {
      background: #ccc;
      transform: translateY(-1px);
    }

    .btn-secondary, select {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border-main);
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-secondary:hover, select:hover {
      background: var(--bg-card-hover);
      border-color: var(--border-hover);
    }

    /* Range Pill Selector */
    .pill-group {
      background: var(--bg-card);
      border: 1px solid var(--border-main);
      border-radius: 8px;
      padding: 3px;
      display: inline-flex;
      gap: 2px;
    }

    .pill-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      padding: 5px 12px;
      border-radius: 5px;
      font-size: 12px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .pill-btn:hover {
      color: var(--text-primary);
    }

    .pill-btn.active {
      background: #222222;
      color: #ffffff;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* Insights Banner */
    .insights-banner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
      margin-top: 24px;
    }

    .insight-box {
      background: var(--bg-card);
      border: 1px solid var(--border-main);
      border-radius: 10px;
      padding: 16px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .insight-icon {
      font-size: 20px;
      line-height: 1;
      padding: 8px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .insight-content h4 {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .insight-content p {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .insight-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
      font-family: var(--font-mono);
    }

    /* Tabs Navigation */
    .tabs-nav {
      display: flex;
      gap: 24px;
      margin-top: 28px;
      border-bottom: 1px solid var(--border-main);
    }

    .tab-item {
      padding: 12px 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      position: relative;
      transition: color 0.15s ease;
    }

    .tab-item:hover {
      color: var(--text-primary);
    }

    .tab-item.active {
      color: var(--text-primary);
      font-weight: 600;
    }

    .tab-item.active::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 2px;
      background: #ffffff;
    }

    /* KPI Cards Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 24px;
    }

    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border-main);
      border-radius: 12px;
      padding: 20px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-card:hover {
      border-color: var(--border-hover);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-secondary);
      font-weight: 500;
      margin-bottom: 12px;
    }

    .kpi-value {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -0.04em;
      color: var(--text-primary);
      line-height: 1;
    }

    .kpi-footer {
      margin-top: 10px;
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    /* Battery Fill Visualizer */
    .battery-visualizer {
      width: 44px;
      height: 22px;
      border: 2px solid #555555;
      border-radius: 4px;
      padding: 2px;
      position: relative;
      display: inline-block;
    }

    .battery-visualizer::after {
      content: '';
      position: absolute;
      right: -5px;
      top: 5px;
      width: 3px;
      height: 8px;
      background: #555555;
      border-radius: 0 2px 2px 0;
    }

    .battery-fill {
      height: 100%;
      background: var(--accent-green);
      border-radius: 2px;
      transition: width 0.3s ease;
    }

    /* Status Dot Badges */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-main);
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
    }

    .dot-discharging { background: var(--accent-green); box-shadow: 0 0 8px var(--accent-green); }
    .dot-charging { background: var(--accent-blue); box-shadow: 0 0 8px var(--accent-blue); }
    .dot-full { background: var(--accent-cyan); }
    .dot-warning { background: var(--accent-amber); }

    /* Multi-Chart Grid */
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(620px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }

    @media (max-width: 768px) {
      .charts-grid { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--bg-card);
      border: 1px solid var(--border-main);
      border-radius: 12px;
      padding: 24px;
      transition: border-color 0.2s ease;
    }

    .chart-card:hover {
      border-color: var(--border-hover);
    }

    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .chart-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .chart-subtitle {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .chart-box {
      height: 320px;
      position: relative;
    }

    /* Table Section & Filters */
    .table-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .search-input {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border-main);
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-family: inherit;
      min-width: 240px;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--accent-blue);
    }

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }

    th {
      border-bottom: 1px solid var(--border-main);
      color: var(--text-secondary);
      font-weight: 500;
      padding: 12px 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      text-transform: uppercase;
      cursor: pointer;
      user-select: none;
    }

    th:hover {
      color: var(--text-primary);
    }

    td {
      border-bottom: 1px solid #161616;
      padding: 12px 16px;
      color: var(--text-primary);
      font-family: var(--font-mono);
    }

    tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 16px;
      font-size: 13px;
      color: var(--text-secondary);
    }

    /* Hardware Specs Grid */
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }

    .spec-item {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-main);
      padding: 16px;
      border-radius: 8px;
    }

    .spec-label {
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 4px;
      text-transform: uppercase;
      font-weight: 500;
    }

    .spec-value {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      font-family: var(--font-mono);
    }

    footer {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--border-main);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="app-header">
      <div class="brand-group">
        <div class="app-logo-badge">⚡</div>
        <div class="brand-title">
          <h1>bathist</h1>
          <p>Battery Analytics & Power Telemetry</p>
        </div>
      </div>

      <div class="toolbar">
        <select id="batterySelect" onchange="updateDashboard()"></select>

        <div class="pill-group" id="rangeGroup">
          <button class="pill-btn" onclick="setTimeRange('1h')">1h</button>
          <button class="pill-btn" onclick="setTimeRange('6h')">6h</button>
          <button class="pill-btn" onclick="setTimeRange('12h')">12h</button>
          <button class="pill-btn" onclick="setTimeRange('24h')">24h</button>
          <button class="pill-btn" onclick="setTimeRange('7d')">7d</button>
          <button class="pill-btn" onclick="setTimeRange('30d')">30d</button>
          <button class="pill-btn" onclick="setTimeRange('all')">All</button>
        </div>

        <button class="btn-primary" onclick="exportData('csv')">Export CSV</button>
        <button class="btn-secondary" onclick="exportData('json')">Export JSON</button>
      </div>
    </header>

    <!-- Automated Insights Banner -->
    <div class="insights-banner">
      <div class="insight-box">
        <div class="insight-icon">🩺</div>
        <div class="insight-content">
          <h4>Battery Health Condition</h4>
          <p id="insHealth">--</p>
          <div class="insight-sub" id="insHealthSub">--</div>
        </div>
      </div>

      <div class="insight-box">
        <div class="insight-icon">⚡</div>
        <div class="insight-content">
          <h4>Power Profile</h4>
          <p id="insPower">--</p>
          <div class="insight-sub" id="insPowerSub">--</div>
        </div>
      </div>

      <div class="insight-box">
        <div class="insight-icon">⏳</div>
        <div class="insight-content">
          <h4>Estimated Runtime</h4>
          <p id="insRuntime">--</p>
          <div class="insight-sub" id="insRuntimeSub">--</div>
        </div>
      </div>

      <div class="insight-box">
        <div class="insight-icon">📊</div>
        <div class="insight-content">
          <h4>Telemetry Range</h4>
          <p id="insTelemetry">--</p>
          <div class="insight-sub" id="insTelemetrySub">--</div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <nav class="tabs-nav">
      <div class="tab-item active" onclick="switchTab('overview')">Overview</div>
      <div class="tab-item" onclick="switchTab('analytics')">Power & Energy</div>
      <div class="tab-item" onclick="switchTab('health')">Health & Voltage</div>
      <div class="tab-item" onclick="switchTab('table')">Snapshot Logs</div>
      <div class="tab-item" onclick="switchTab('specs')">Hardware Specs</div>
    </nav>

    <!-- Tab 1: Overview -->
    <div id="tab-overview">
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-header">
            <span>Battery Level</span>
            <div class="battery-visualizer">
              <div class="battery-fill" id="batFill" style="width: 0%;"></div>
            </div>
          </div>
          <div class="kpi-value" id="valCapacity">--%</div>
          <div class="kpi-footer" id="valEnergy">-- Wh / -- Wh</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>State of Health (SoH)</span>
            <span id="badgeState" class="status-badge"><span id="dotState" class="dot"></span> <span id="txtState">--</span></span>
          </div>
          <div class="kpi-value" id="valSoh">--%</div>
          <div class="kpi-footer" id="valDesignCapacity">Design: -- Wh</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Current Power Draw</span>
            <span>⚡</span>
          </div>
          <div class="kpi-value" id="valPower">-- W</div>
          <div class="kpi-footer" id="valPowerStats">Avg: -- W | Peak: -- W</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Voltage & Cycles</span>
            <span>🔌</span>
          </div>
          <div class="kpi-value" id="valVoltage">-- V</div>
          <div class="kpi-footer" id="valCycles">Cycles: --</div>
        </div>
      </div>

      <div class="charts-grid">
        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">Battery Level (%) & Charge/Discharge State</div>
              <div class="chart-subtitle">Capacity percentage timeline over selected period</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartCapacity"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">Real-Time Power Draw (Watts)</div>
              <div class="chart-subtitle">Active system power draw and charging rates</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartPower"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Power & Energy -->
    <div id="tab-analytics" style="display: none;">
      <div class="charts-grid">
        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">Energy Stored (Wh) vs Full & Design Capacity</div>
              <div class="chart-subtitle">Stored energy dynamics compared against factory specifications</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartEnergy"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">Power Consumption Curve</div>
              <div class="chart-subtitle">System wattage load profile</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartPowerAnalytics"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: Health & Voltage -->
    <div id="tab-health" style="display: none;">
      <div class="charts-grid">
        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">State of Health (SoH %) & Charge Cycles</div>
              <div class="chart-subtitle">Battery capacity degradation over time</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartHealth"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-header">
            <div>
              <div class="chart-title">Voltage Stability Curve (Volts)</div>
              <div class="chart-subtitle">Battery cell voltage dynamics under load</div>
            </div>
          </div>
          <div class="chart-box">
            <canvas id="chartVoltage"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 4: Snapshot Logs Table -->
    <div id="tab-table" style="display: none;">
      <div class="chart-card">
        <div class="table-controls">
          <input type="text" id="searchInput" class="search-input" placeholder="🔍 Search logs by status, battery..." oninput="onSearchInput()">
          <div style="font-size: 13px; color: var(--text-secondary);">
            Rows per page:
            <select id="pageSizeSelect" onchange="onPageSizeChange()" style="padding: 4px 8px;">
              <option value="15">15</option>
              <option value="30" selected>30</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th onclick="sortTable('timestamp')">Timestamp ↕</th>
                <th onclick="sortTable('batteryName')">Device ↕</th>
                <th onclick="sortTable('capacityPercent')">Capacity ↕</th>
                <th onclick="sortTable('status')">Status ↕</th>
                <th onclick="sortTable('powerW')">Power (W) ↕</th>
                <th onclick="sortTable('voltageV')">Voltage (V) ↕</th>
                <th onclick="sortTable('energyNowWh')">Energy (Wh) ↕</th>
                <th onclick="sortTable('sohPercent')">SoH % ↕</th>
              </tr>
            </thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div class="pagination">
          <div id="pageInfo">Showing 0 to 0 of 0 entries</div>
          <div style="display: flex; gap: 8px;">
            <button class="btn-secondary" onclick="changePage(-1)">Previous</button>
            <button class="btn-secondary" onclick="changePage(1)">Next</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 5: Hardware Specs -->
    <div id="tab-specs" style="display: none;">
      <div class="chart-card">
        <div class="chart-title">Battery Hardware Diagnostics</div>
        <div class="specs-grid" id="specsContent"></div>
      </div>
    </div>

    <!-- Footer -->
    <footer>
      <div>Generated by <strong>bathist</strong> • High Performance Linux Telemetry</div>
      <div id="genDate"></div>
    </footer>
  </div>

  <script>
    // Decode embedded Base64 payload cleanly
    const PAYLOAD_BASE64 = "{{{payloadBase64}}}";
    function decodePayload(b64) {
      try {
        const binStr = atob(b64);
        const bytes = Uint8Array.from(binStr, c => c.charCodeAt(0));
        return JSON.parse(new TextDecoder().decode(bytes));
      } catch (e) {
        console.error("Failed to decode embedded report payload", e);
        return { allBatNames: [], readingsMap: {}, summaries: [], staticInfoMap: {}, timeRange: "24h", generatedAt: new Date().toISOString() };
      }
    }

    const DATA = decodePayload(PAYLOAD_BASE64);
    let currentBattery = DATA.allBatNames[0] || "BAT0";
    let currentTimeRange = DATA.timeRange || "24h";

    // Table State
    let currentPage = 1;
    let pageSize = 30;
    let searchQuery = "";
    let sortColumn = "timestamp";
    let sortAsc = false;

    // Chart instances
    const chartInstances = {};

    document.getElementById("genDate").textContent = new Date(DATA.generatedAt).toLocaleString();

    const batSelect = document.getElementById("batterySelect");
    batSelect.innerHTML = DATA.allBatNames.map(b => `<option value="${b}">Battery ${b}</option>`).join("");
    if (DATA.allBatNames.length > 1) {
      batSelect.innerHTML += `<option value="ALL">All Batteries</option>`;
    }

    function switchTab(tabName) {
      const tabs = ['overview', 'analytics', 'health', 'table', 'specs'];
      tabs.forEach(t => {
        const el = document.getElementById("tab-" + t);
        if (el) el.style.display = (t === tabName) ? "block" : "none";
      });

      document.querySelectorAll(".tab-item").forEach((el, idx) => {
        if (tabs[idx] === tabName) el.classList.add("active");
        else el.classList.remove("active");
      });

      setTimeout(updateDashboard, 50);
    }

    function setTimeRange(range) {
      currentTimeRange = range;
      updateRangeButtons();
      updateDashboard();
    }

    function updateRangeButtons() {
      document.querySelectorAll("#rangeGroup .pill-btn").forEach(btn => {
        if (btn.textContent.toLowerCase() === currentTimeRange.toLowerCase()) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });
    }

    function filterReadings() {
      let readings = [];
      if (currentBattery === "ALL") {
        Object.values(DATA.readingsMap).forEach(arr => readings.push(...arr));
        readings.sort((a, b) => a.timestamp - b.timestamp);
      } else {
        readings = DATA.readingsMap[currentBattery] || [];
      }

      if (readings.length === 0 || currentTimeRange === "all") return readings;

      const maxTimestamp = readings[readings.length - 1].timestamp;
      let secondsAgo = 86400;
      if (currentTimeRange === "1h") secondsAgo = 3600;
      else if (currentTimeRange === "6h") secondsAgo = 21600;
      else if (currentTimeRange === "12h") secondsAgo = 43200;
      else if (currentTimeRange === "24h") secondsAgo = 86400;
      else if (currentTimeRange === "7d") secondsAgo = 7 * 86400;
      else if (currentTimeRange === "30d") secondsAgo = 30 * 86400;

      const cutoff = maxTimestamp - secondsAgo;
      const filtered = readings.filter(r => r.timestamp >= cutoff);
      return filtered.length > 0 ? filtered : readings;
    }

    function updateDashboard() {
      currentBattery = batSelect.value;
      const readings = filterReadings();

      updateInsights(readings);
      updateKPIs(readings);
      renderAllCharts(readings);
      renderTable(readings);
      renderSpecs();
    }

    function updateInsights(readings) {
      if (!readings || readings.length === 0) return;

      const latest = readings[readings.length - 1];
      const powers = readings.map(r => r.powerW);
      const avgP = (powers.reduce((a, b) => a + b, 0) / powers.length).toFixed(1);
      const maxP = Math.max(...powers).toFixed(1);

      // Health Insight
      const soh = latest.sohPercent.toFixed(1);
      let healthText = soh >= 90 ? "Excellent (" + soh + "%)" : soh >= 75 ? "Good (" + soh + "%)" : "Degraded (" + soh + "%)";
      document.getElementById("insHealth").textContent = healthText;
      document.getElementById("insHealthSub").textContent = "Design: " + latest.energyFullDesignWh + " Wh | Current: " + latest.energyFullWh + " Wh";

      // Power Insight
      document.getElementById("insPower").textContent = "Avg " + avgP + " W (Peak " + maxP + " W)";
      document.getElementById("insPowerSub").textContent = "Status: " + latest.status + " (" + latest.capacityPercent + "%)";

      // Runtime Insight
      if (latest.status.toLowerCase() === "discharging" && latest.timeToEmptyMin) {
        const h = Math.floor(latest.timeToEmptyMin / 60);
        const m = latest.timeToEmptyMin % 60;
        document.getElementById("insRuntime").textContent = "~" + (h > 0 ? h + "h " : "") + m + "m remaining";
      } else if (latest.status.toLowerCase() === "charging" && latest.timeToFullMin) {
        const h = Math.floor(latest.timeToFullMin / 60);
        const m = latest.timeToFullMin % 60;
        document.getElementById("insRuntime").textContent = "~" + (h > 0 ? h + "h " : "") + m + "m to full charge";
      } else {
        document.getElementById("insRuntime").textContent = latest.status === "Full" ? "Full Battery" : "Plugged AC";
      }
      document.getElementById("insRuntimeSub").textContent = "Voltage: " + latest.voltageV.toFixed(2) + " V";

      // Telemetry Insight
      document.getElementById("insTelemetry").textContent = readings.length.toLocaleString() + " Log Snapshots";
      const firstDate = new Date(readings[0].timestamp * 1000).toLocaleDateString();
      const lastDate = new Date(latest.timestamp * 1000).toLocaleDateString();
      document.getElementById("insTelemetrySub").textContent = firstDate + " - " + lastDate;
    }

    function updateKPIs(readings) {
      if (!readings || readings.length === 0) return;

      const latest = readings[readings.length - 1];
      document.getElementById("valCapacity").textContent = latest.capacityPercent + "%";
      document.getElementById("batFill").style.width = latest.capacityPercent + "%";

      const dot = document.getElementById("dotState");
      dot.className = "dot";
      const st = latest.status.toLowerCase();
      if (st === "discharging") dot.classList.add("dot-discharging");
      else if (st === "charging") dot.classList.add("dot-charging");
      else if (st === "full") dot.classList.add("dot-full");
      else dot.classList.add("dot-warning");

      document.getElementById("txtState").textContent = latest.status;
      document.getElementById("valEnergy").textContent = latest.energyNowWh + " Wh / " + latest.energyFullWh + " Wh";
      document.getElementById("valSoh").textContent = latest.sohPercent.toFixed(1) + "%";
      document.getElementById("valDesignCapacity").textContent = "Design: " + latest.energyFullDesignWh + " Wh";

      document.getElementById("valPower").textContent = latest.powerW.toFixed(2) + " W";

      const powers = readings.map(r => r.powerW);
      const avgP = (powers.reduce((a, b) => a + b, 0) / powers.length).toFixed(2);
      const maxP = Math.max(...powers).toFixed(2);
      document.getElementById("valPowerStats").textContent = "Avg: " + avgP + " W | Peak: " + maxP + " W";

      document.getElementById("valVoltage").textContent = latest.voltageV.toFixed(2) + " V";
      document.getElementById("valCycles").textContent = "Cycles: " + (latest.cycleCount || 0);
    }

    function createChart(canvasId, type, data, options) {
      if (chartInstances[canvasId]) chartInstances[canvasId].destroy();
      const ctx = document.getElementById(canvasId);
      if (!ctx) return;
      chartInstances[canvasId] = new Chart(ctx, { type, data, options });
    }

    function renderAllCharts(readings) {
      const labels = readings.map(r => new Date(r.timestamp * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
      const caps = readings.map(r => r.capacityPercent);
      const powers = readings.map(r => r.powerW);
      const energies = readings.map(r => r.energyNowWh);
      const maxEnergies = readings.map(r => r.energyFullWh);
      const designEnergies = readings.map(r => r.energyFullDesignWh);
      const sohs = readings.map(r => r.sohPercent);
      const voltages = readings.map(r => r.voltageV);

      const commonScales = {
        x: { grid: { color: '#161616' }, ticks: { color: '#666666', maxTicksLimit: 10 } },
        y: { grid: { color: '#161616' }, ticks: { color: '#666666' } }
      };

      // 1. Capacity Chart
      createChart('chartCapacity', 'line', {
        labels,
        datasets: [{
          label: 'Capacity (%)',
          data: caps,
          borderColor: '#ffffff',
          backgroundColor: 'rgba(255, 255, 255, 0.05)',
          fill: true,
          tension: 0.2,
          borderWidth: 2,
          pointRadius: readings.length > 100 ? 0 : 2
        }]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: commonScales.x, y: { min: 0, max: 100, ...commonScales.y } }
      });

      // 2. Power Chart
      createChart('chartPower', 'line', {
        labels,
        datasets: [{
          label: 'Power Draw (W)',
          data: powers,
          borderColor: '#0070f3',
          backgroundColor: 'rgba(0, 112, 243, 0.08)',
          fill: true,
          tension: 0.2,
          borderWidth: 2,
          pointRadius: readings.length > 100 ? 0 : 2
        }]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: commonScales
      });

      // 3. Energy Chart
      createChart('chartEnergy', 'line', {
        labels,
        datasets: [
          { label: 'Energy Now (Wh)', data: energies, borderColor: '#06b6d4', backgroundColor: 'rgba(6, 182, 212, 0.1)', fill: true, tension: 0.2, borderWidth: 2 },
          { label: 'Full Capacity (Wh)', data: maxEnergies, borderColor: '#10b981', borderWidth: 1.5, borderDash: [4, 4], pointRadius: 0 },
          { label: 'Design Capacity (Wh)', data: designEnergies, borderColor: '#8b5cf6', borderWidth: 1.5, borderDash: [2, 2], pointRadius: 0 }
        ]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { labels: { color: '#888888' } } },
        scales: commonScales
      });

      // 4. Power Analytics Chart
      createChart('chartPowerAnalytics', 'line', {
        labels,
        datasets: [{
          label: 'Power Load (W)',
          data: powers,
          borderColor: '#f59e0b',
          backgroundColor: 'rgba(245, 158, 11, 0.1)',
          fill: true,
          tension: 0.2,
          borderWidth: 2
        }]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: commonScales
      });

      // 5. Health & Cycles Chart
      createChart('chartHealth', 'line', {
        labels,
        datasets: [{
          label: 'State of Health (SoH %)',
          data: sohs,
          borderColor: '#10b981',
          backgroundColor: 'rgba(16, 185, 129, 0.08)',
          fill: true,
          tension: 0.2,
          borderWidth: 2
        }]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: commonScales.x, y: { min: 50, max: 100, ...commonScales.y } }
      });

      // 6. Voltage Chart
      createChart('chartVoltage', 'line', {
        labels,
        datasets: [{
          label: 'Voltage (V)',
          data: voltages,
          borderColor: '#8b5cf6',
          backgroundColor: 'rgba(139, 92, 246, 0.08)',
          fill: true,
          tension: 0.2,
          borderWidth: 2
        }]
      }, {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: commonScales
      });
    }

    // Table Pagination & Search Functions
    function onSearchInput() {
      searchQuery = document.getElementById("searchInput").value.toLowerCase();
      currentPage = 1;
      renderTable(filterReadings());
    }

    function onPageSizeChange() {
      pageSize = parseInt(document.getElementById("pageSizeSelect").value, 10);
      currentPage = 1;
      renderTable(filterReadings());
    }

    function sortTable(col) {
      if (sortColumn === col) sortAsc = !sortAsc;
      else { sortColumn = col; sortAsc = true; }
      renderTable(filterReadings());
    }

    function changePage(delta) {
      currentPage += delta;
      renderTable(filterReadings());
    }

    function renderTable(readings) {
      const tbody = document.getElementById("tableBody");
      let list = [...readings];

      if (searchQuery) {
        list = list.filter(r => 
          r.status.toLowerCase().includes(searchQuery) ||
          r.batteryName.toLowerCase().includes(searchQuery) ||
          new Date(r.timestamp * 1000).toLocaleString().toLowerCase().includes(searchQuery)
        );
      }

      list.sort((a, b) => {
        let valA = a[sortColumn];
        let valB = b[sortColumn];
        if (typeof valA === 'string') return sortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        return sortAsc ? valA - valB : valB - valA;
      });

      const totalItems = list.length;
      const totalPages = Math.ceil(totalItems / pageSize) || 1;
      currentPage = Math.max(1, Math.min(currentPage, totalPages));

      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, totalItems);
      const pageSlice = list.slice(startIdx, endIdx);

      tbody.innerHTML = pageSlice.map(r => `
        <tr>
          <td>${new Date(r.timestamp * 1000).toLocaleString()}</td>
          <td>${r.batteryName}</td>
          <td>${r.capacityPercent}%</td>
          <td>${r.status}</td>
          <td>${r.powerW.toFixed(2)} W</td>
          <td>${r.voltageV.toFixed(2)} V</td>
          <td>${r.energyNowWh.toFixed(1)} Wh</td>
          <td>${r.sohPercent.toFixed(1)}%</td>
        </tr>
      `).join("");

      document.getElementById("pageInfo").textContent = 
        totalItems === 0 
          ? "No matching entries" 
          : "Showing " + (startIdx + 1) + " to " + endIdx + " of " + totalItems.toLocaleString() + " entries (Page " + currentPage + " of " + totalPages + ")";
    }

    function renderSpecs() {
      const info = DATA.staticInfoMap[currentBattery] || {};
      const container = document.getElementById("specsContent");
      container.innerHTML = `
        <div class="spec-item"><div class="spec-label">Device Name</div><div class="spec-value">${info.name || currentBattery}</div></div>
        <div class="spec-item"><div class="spec-label">Manufacturer</div><div class="spec-value">${info.manufacturer || 'N/A'}</div></div>
        <div class="spec-item"><div class="spec-label">Model Name</div><div class="spec-value">${info.modelName || 'N/A'}</div></div>
        <div class="spec-item"><div class="spec-label">Serial Number</div><div class="spec-value">${info.serialNumber || 'N/A'}</div></div>
        <div class="spec-item"><div class="spec-label">Technology</div><div class="spec-value">${info.technology || 'N/A'}</div></div>
        <div class="spec-item"><div class="spec-label">Design Capacity</div><div class="spec-value">${info.energyFullDesignWh || 0} Wh</div></div>
        <div class="spec-item"><div class="spec-label">Min Voltage Design</div><div class="spec-value">${info.voltageMinDesignV || 0} V</div></div>
        <div class="spec-item"><div class="spec-label">Sysfs Node Path</div><div class="spec-value">${info.path || '/sys/class/power_supply/' + currentBattery}</div></div>
      `;
    }

    function exportData(format) {
      const readings = filterReadings();
      if (format === 'json') {
        downloadFile(JSON.stringify(readings, null, 2), "bathist_export.json", "application/json");
      } else if (format === 'csv') {
        if (readings.length === 0) return;
        const keys = Object.keys(readings[0]);
        const csvRows = [keys.join(",")];
        readings.forEach(r => csvRows.push(keys.map(k => JSON.stringify(r[k] ?? "")).join(",")));
        downloadFile(csvRows.join("\n"), "bathist_export.csv", "text/csv");
      }
    }

    function downloadFile(content, fileName, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      a.click();
      URL.revokeObjectURL(url);
    }

    updateRangeButtons();
    updateDashboard();
  </script>
</body>
</html>
